{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Myna Sign",
  "mainBinaryName": "myna-sign",
  "version": "2.0.0",
  "identifier": "ws.nyaa.myna-sign",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Myna Sign",
        "width": 1120,
        "height": 760,
        "minWidth": 760,
        "minHeight": 540,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "マイナンバーカードでファイルや PDF に署名",
    "longDescription": "マイナンバーカードの署名用証明書で任意のファイルや PDF に署名できます。署名を検証することもできます。",
    "linux": {
      "deb": {
        "depends": [
          "libpcsclite1",
          "pcscd"
        ]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
